{
  "chat.mcp.discovery.enabled": true,
  "github.copilot.chat.codeGeneration.instructions": [
    {
      "file": ".copilot/instructions.md"
    }
  ],
  "files.associations": {
    "*.pbir": "json",
    "*.tmdl": "plaintext"
  },
  "json.schemas": [
    {
      "fileMatch": [
        "**/definition.pbir"
      ],
      "url": "https://developer.microsoft.com/json-schemas/fabric/item/report/definitionProperties/1.0.0/schema.json"
    },
    {
      "fileMatch": [
        "**/definition/report.json"
      ],
      "url": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/report/1.0.0/schema.json"
    }
  ]
}
